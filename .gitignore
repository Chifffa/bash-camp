# =============================================================================
# bash-camp
# =============================================================================
# Everything bash-camp builds lives in $CAMP_HOME (~/.camp), never in the
# checkout, so only the private overlay and local tests stay out of git here.

# Credentials, keys and env files of the machine this checkout lives on; see
# secrets.example/ for the format.
secrets/

